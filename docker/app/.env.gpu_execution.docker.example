GPU_EXECUTION_SERVICE_TOKEN=replace-me
SQLALCHEMY_DATABASE_URL=postgresql://telegram:Telegram2026@gpu_execution_postgres:5432/telegram_agent
REDIS_URL=redis://redis:6379/0
GPU_SHARED_STORAGE_ROOT=/app/media
HF_TOKEN=
COSYVOICE_MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE_MODEL_DIR=/opt/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B
SAM_AUDIO_MODEL=facebook/sam-audio-small
# ImageBind writes CWD/.checkpoints (~4.5 GiB), not the Hugging Face cache.
SAM_AUDIO_CHECKPOINTS_DIR=/app/.checkpoints
GPU_JOB_DEFAULT_TIMEOUT_SECONDS=14400
GPU_JOB_MAX_TIMEOUT_SECONDS=86400
GPU_JOB_DEFAULT_MAX_ATTEMPTS=3
GPU_JOB_MAX_ATTEMPTS=10
GPU_JOB_LEASE_SECONDS=120
GPU_JOB_HEARTBEAT_SECONDS=5
GPU_JOB_CANCEL_GRACE_SECONDS=20
GPU_JOB_RETRY_BASE_SECONDS=15
GPU_OUTBOX_POLL_INTERVAL_SECONDS=2
GPU_RECOVERY_POLL_INTERVAL_SECONDS=30
GPU_OUTBOX_LEASE_SECONDS=60
GPU_OUTBOX_BATCH_SIZE=50
LOG_LEVEL=INFO
