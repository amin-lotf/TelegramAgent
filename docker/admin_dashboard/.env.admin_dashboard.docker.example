# Read-only database URLs (prefer dashboard_ro user; not the write telegram user)
TELEGRAM_INGRESS_RO_DATABASE_URL=postgresql+asyncpg://dashboard_ro:CHANGE_ME@telegram_ingress_postgres:5432/telegram_agent
CONTENT_PROCESSING_RO_DATABASE_URL=postgresql+asyncpg://dashboard_ro:CHANGE_ME@content_processing_postgres:5432/telegram_agent
AGENT_RUNTIME_RO_DATABASE_URL=postgresql+asyncpg://dashboard_ro:CHANGE_ME@agent_runtime_postgres:5432/telegram_agent
TELEGRAM_AUTH_RO_DATABASE_URL=postgresql+asyncpg://dashboard_ro:CHANGE_ME@telegram_auth_postgres:5432/telegram_agent

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
SESSION_COOKIE_NAME=admin_dashboard_session
SESSION_HTTPS_ONLY=false

# Query / pool safety
DB_QUERY_TIMEOUT_SECONDS=3
DB_CONNECT_TIMEOUT_SECONDS=2
DB_POOL_SIZE=2
DB_POOL_MAX_OVERFLOW=0

# UI / listing
LIST_PAGE_SIZE=50
LIST_MAX_PAGE_SIZE=200
MASK_MEDIA_PATHS=true
MASK_MESSAGE_TEXT=false
ENABLE_AUTH_DB_ENRICHMENT=true

# Logging / HTTP
LOG_LEVEL=INFO
ALLOWED_ORIGINS=
