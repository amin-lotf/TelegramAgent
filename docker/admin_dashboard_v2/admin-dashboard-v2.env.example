# Provision separate PostgreSQL roles with CONNECT, USAGE, and SELECT only.
TELEGRAM_INGRESS_READ_DATABASE_URL=postgresql://dashboard_v2_ro:replace-me@telegram_ingress_postgres:5432/telegram_agent
CONTENT_PROCESSING_READ_DATABASE_URL=postgresql://dashboard_v2_ro:replace-me@content_processing_postgres:5432/telegram_agent
AGENT_RUNTIME_READ_DATABASE_URL=postgresql://dashboard_v2_ro:replace-me@agent_runtime_postgres:5432/telegram_agent
TELEGRAM_AUTH_READ_DATABASE_URL=postgresql://dashboard_v2_ro:replace-me@telegram_auth_postgres:5432/telegram_agent

ADMIN_DASHBOARD_V2_USERNAME=admin
# Generate with: python -m telegram_agent.core.admin_dashboard_v2.security.passwords
# Paste the full generated value. Compose loads this file with format: raw.
ADMIN_DASHBOARD_V2_PASSWORD_HASH=replace-with-generated-pbkdf2-hash
ADMIN_DASHBOARD_V2_CURSOR_SECRET=replace-with-at-least-32-random-characters

DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=1
DATABASE_CONNECT_TIMEOUT_SECONDS=1
DATABASE_STATEMENT_TIMEOUT_MS=3000
DEFAULT_PAGE_SIZE=30
MAXIMUM_PAGE_SIZE=100
LISTING_CHUNK_SIZE=100
LISTING_SCAN_LIMIT=2000
MAXIMUM_MEDIA_ASSETS=200
DISPLAY_TIMEZONE=UTC
LOG_LEVEL=INFO
